<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/w_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:letterSpacing="0.12"
            android:text="NOW"
            android:textColor="#16A34A"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="0"
            android:textColor="#0F172A"
            android:textSize="11sp" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Midday Read"
                android:textColor="#0F172A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Core course reading"
                android:textColor="#475569"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="until 15:00"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginStart="10dp">

            <ImageView
                android:id="@+id/w_ring"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/w_ring_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="0/8"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/w_progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:max="8"
            android:progress="0"
            android:progressBackgroundTint="#E2E8F0"
            android:progressTint="#16A34A" />

        <TextView
            android:id="@+id/w_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="next 15:00"
            android:textColor="#64748B"
            android:textSize="10sp" />

        <ImageButton
            android:id="@+id/w_done"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_check_button"
            android:contentDescription="Mark done"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_check_white" />
    </LinearLayout>
</LinearLayout>
